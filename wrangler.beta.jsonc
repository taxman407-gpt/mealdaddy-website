{
 "$schema":"./node_modules/wrangler/config-schema.json",
 "name":"mealdaddy-october-test",
 "main":"./worker.beta.js",
 "compatibility_date":"2026-07-27",
 "build":{"command":"npm run build && node scripts/build-private-beta.mjs"},
 "workers_dev":true,"preview_urls":false,
 "assets":{"directory":"./dist-beta","binding":"ASSETS","run_worker_first":true,"html_handling":"auto-trailing-slash","not_found_handling":"404-page"}
